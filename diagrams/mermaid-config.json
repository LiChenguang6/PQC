    "fontSize": "17px",
    "primaryColor": "#e8f1ff",
    "primaryTextColor": "#172b4d",
    "primaryBorderColor": "#4c75ad",
    "lineColor": "#52647a",
    "secondaryColor": "#e9f7ef",
    "tertiaryColor": "#fff5df",
    "clusterBkg": "#f7f9fc",
